{
  "manifest_version": 3,
  "name": "Almanca Kelime Asistanı",
  "version": "0.4.0",
  "description": "Sağ tıkladığın kelimenin Almancasını, artikelini, çoğulunu, örnek cümlesini ve okunuşunu gösterir.",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://de.wiktionary.org/*",
    "https://tr.wiktionary.org/*",
    "https://en.wiktionary.org/*",
    "https://api.tatoeba.org/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["i18n.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Kelime defterini aç",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
